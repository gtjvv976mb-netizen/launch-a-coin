{
  // Launch a Card only. Public HTTPS and the mainnet RPC passed release checks.
  "name": "launch-a-card",
  "account_id": "985281cb00d5f7379896b62a03e0edb7",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Require an existing compatible CPU allowance; never purchase or upgrade a plan.
  "limits": {"cpu_ms": 30000},
  "assets": {"directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none"},
  // Cloudflare for SaaS phase 2: launchacard.fun and www are custom hostnames on the launchacard.com zone (fallback
  // edge.launchacard.com) and reach this Worker through its */* route only. The launchacard.fun Worker custom domains
  // are gone; never add them back (they would replace the DNS-only CNAMEs and put the site on PLDT-blocked IPs).
  "routes": [{"pattern": "*/*", "zone_name": "launchacard.com"}],
  // A routed Worker cannot fetch() its own zone, so own-origin asset checks go through this binding.
  "services": [{"binding": "SELF", "service": "launch-a-card"}],
  "vars": {
    "HF_ENV": "production", "APP_SLUG": "launch-a-card",
    "CARDDEX_PUBLIC_ORIGIN": "https://launchacard.fun",
    "CARDDEX_DEPLOYMENT_ENV": "production",
    // Configure CARDDEX_MAINNET_RPC_URL as a Worker secret with a provider endpoint.
    // Two switches. CARDDEX_LIVE_LAUNCH_ENABLED ("true" only) opens new mainnet launches.
    // CARDDEX_LIVE_RECOVERY_ENABLED (on unless "false") lets creators sign in and finish saved launches.
    // To stop new launches in an incident, set only CARDDEX_LIVE_LAUNCH_ENABLED to "false": recovery keeps working.
    "CARDDEX_LIVE_LAUNCH_ENABLED": "true",
    "CARDDEX_LIVE_RECOVERY_ENABLED": "true",
    // CARDDEX_LIVE_FEE_SHARING ("true" only) offers the optional pump.fun creator fee split after the card.
    "CARDDEX_LIVE_FEE_SHARING": "true"
    // CARDDEX_X_AUTOPOST ("true" only, with the four X secrets set by `wrangler secret put`) posts opted-in new coins on
    // @launchacard from the cron below. Off until the owner sets it (README, "Announcements on @launchacard").
    // CARDDEX_ADMIN_WALLETS (comma list of the owner's wallets) opens the private reply helper, /admin/replies, which
    // reads X search with the X_BEARER_TOKEN secret (README, "Reply helper"). Unset: the page answers "not found".
  },
  // The announcement job (server.ts scheduled). `versions upload`/`versions deploy` do not apply triggers: add this
  // cron in the Cloudflare dashboard (Worker > Settings > Triggers), never with `wrangler deploy` or `triggers deploy`.
  "triggers": {"crons": ["*/10 * * * *"]},
  "d1_databases": [{"binding": "DB", "database_name": "launch-a-card", "database_id": "ffc8ba69-4d9d-404c-9c3d-e4a7f187cb3a", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "STORAGE", "bucket_name": "launch-a-card"}]
}
