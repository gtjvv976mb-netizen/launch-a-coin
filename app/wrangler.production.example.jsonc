{
  // Review and copy to wrangler.production.jsonc after creating this platform's own resources.
  // Never substitute MintDex bindings. The placeholder D1 ID is intentionally undeployable.
  "name": "launch-a-card",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none"},
  "routes": [{"pattern": "launchacard.fun", "custom_domain": true}],
  "vars": {
    "HF_ENV": "production", "APP_SLUG": "launch-a-card",
    "CARDDEX_PUBLIC_ORIGIN": "https://launchacard.fun",
    "CARDDEX_DEPLOYMENT_ENV": "production",
    // Configure CARDDEX_MAINNET_RPC_URL with `wrangler secret put`, not in source.
    // New launches open only on "true"; saved-launch recovery stays on unless "false", "0", "off" or "no" (any case).
    // Optional CARDDEX_MIRROR_REDIRECT: "true" sends page views on mirror hosts to the public origin (leave unset until
    // the public origin is reachable from every network).
    "CARDDEX_LIVE_LAUNCH_ENABLED": "false",
    "CARDDEX_LIVE_RECOVERY_ENABLED": "true"
    // Optional CARDDEX_LIVE_WALLET_FIRST: wallets that sign before the page co-signs. Unset is Phantom only; "none" restores page-first.
    // Optional CARDDEX_LIVE_WALLET_BATCH: wallets that approve the coin and its card in one prompt. Unset is no wallet
    // (opt in a wallet, e.g. "Backpack", only after a test on the live site); "none" is the same. Phantom is never batched.
  },
  "d1_databases": [{"binding": "DB", "database_name": "launch-a-card", "database_id": "REPLACE_WITH_OWN_D1_ID", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "STORAGE", "bucket_name": "launch-a-card"}]
}
