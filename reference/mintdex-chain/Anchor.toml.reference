[toolchain]
package_manager = "npm"

[features]
resolution = true
skip-lint = false

[programs.localnet]
mintdex = "4HTSBYfgm5os2kBwFVBv5cd4mPetNmS32Cb4r3YViDon"

[programs.devnet]
mintdex = "4HTSBYfgm5os2kBwFVBv5cd4mPetNmS32Cb4r3YViDon"

[provider]
cluster = "localnet"
wallet = ".keys/test-wallet.json"

[scripts]
test = "npx ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts"

[test.validator]
bind_address = "127.0.0.1"
